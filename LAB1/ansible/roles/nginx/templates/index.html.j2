<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ nginx_page_title }} - {{ ansible_facts['hostname'] }}</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 40rem; margin: 3rem auto; padding: 0 1rem; }
    th { text-align: left; padding-right: 1rem; }
  </style>
</head>
<body>
  <h1>{{ nginx_page_title }}</h1>
  <p>Configured by Ansible from the Packer-built AMI.</p>
  <table>
    <tr><th>Environment</th><td>{{ env_name | default('n/a') }}</td></tr>
    <tr><th>Hostname</th><td>{{ ansible_facts['hostname'] }}</td></tr>
    <tr><th>Instance ID</th><td>{{ aws_instance_id | default('n/a') }}</td></tr>
    <tr><th>AMI</th><td>{{ aws_image_id | default('n/a') }}</td></tr>
    <tr><th>Availability zone</th><td>{{ aws_placement.availability_zone | default('n/a') }}</td></tr>
    <tr><th>Private IP</th><td>{{ ansible_facts['default_ipv4']['address'] | default('n/a') }}</td></tr>
    <tr><th>OS</th><td>{{ ansible_facts['distribution'] }} {{ ansible_facts['distribution_version'] }}</td></tr>
  </table>
</body>
</html>
